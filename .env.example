# ==============================================================================
# NEXSHIELD Environment Variables Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - NEVER commit actual secrets, API keys, or .env files to source control.
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Confirmation HMAC Signing Secret (Required in production)
# Must be at least 32 characters (256-bit entropy).
# Used to cryptographically sign Human-in-the-Loop (HITL) transfer confirmation tokens.
#
# Production Security Invariant:
# If this secret is missing, shorter than 32 characters, or matches trivial patterns
# (e.g., 'password', 'secret', repeated characters), transfer execution will fail-closed
# and disable transfers safely.
#
# In development/test mode, an ephemeral 32-byte cryptographic random secret is
# generated in-memory if this variable is left unset.
#
# Example generation command: openssl rand -hex 32
NEXSHIELD_SERVER_SECRET=example_development_signing_secret_do_not_use_in_production_32chars

# Port (Optional, default 3000)
PORT=3000
